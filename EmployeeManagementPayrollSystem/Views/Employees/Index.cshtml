@model IEnumerable<EmployeeManagementSystem.Data.Models.Employee>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Employees</h2>
            <p class="text-muted mb-0">List of all employees on the Database.</p>
        </div>
        <a asp-controller="Employees" asp-action="Create" class="btn btn-primary">
            + Add Employee
        </a>
    </div>

    <form asp-controller="Employees" asp-action="Details" method="get" class="mb-3">
        <select name="id" class="form-select" onchange="if(this.value) this.form.submit();">
            <option value="" selected disabled>-- Choose an Employee --</option>
            @foreach (var employee in Model)
            {
                <option value="@employee.Id">
                    @employee.FirstName @employee.LastName (@employee.Email)
                </option>
            }
        </select>
    </form>
    <p>

    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info py-4 text-center">
            <p class="mb-2">No employees have been added yet.</p>
            <a asp-controller="Employees" asp-action="Create" class="btn btn-sm btn-primary">Add the first employee</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle bg-white mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Age</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="text-end">Salary</th>
                        <th scope="col">Date Created</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model)
                    {
                        <tr>
                            <td>@employee.Id</td>
                            <td>@employee.FirstName</td>
                            <td>@employee.LastName</td>
                            <td>@employee.Age</td>
                            <td>@employee.Email</td>
                            <td class="text-end">R @employee.Salary.ToString("N2")</td>
                            <td>@employee.DateCreated.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="Employees" asp-action="Update" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Employees" asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>