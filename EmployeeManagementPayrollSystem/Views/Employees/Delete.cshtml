@model EmployeeManagementPayrollSystemUI.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container my-4">
    <h2 class="mb-1 text-danger">Delete Employee</h2>
    <p class="text-muted mb-4">Are you sure you want to delete this employee? This action cannot be undone.</p>

    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle bg-white mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">First Name</th>
                    <th scope="col">Last Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-end">Salary</th>
                    <th scope="col">Date Created</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.Id</td>
                    <td>@Model.FirstName</td>
                    <td>@Model.LastName</td>
                    <td>@Model.Age</td>
                    <td>@Model.Email</td>
                    <td class="text-end">R @Model.Salary.ToString("N2")</td>
                    <td>@Model.DateCreated.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            </tbody>
        </table>
    </div>

    <form asp-controller="Employees" asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>